msgstr "All"

msgid "plugins.generic.citationImpact.index.last3"
msgstr "last 3 years"

msgid "plugins.generic.citationImpact.index.citations"
msgstr "Citations"

msgid "plugins.generic.citationImpact.index.articles"
msgstr "Articles"

msgid "plugins.generic.citationImpact.index.cited"
msgstr "Cited articles"

msgid "plugins.generic.citationImpact.index.note"
msgstr "The {$from}–{$to} column counts articles published in the last 3 years, the window used by the ARJUNA “Dampak Ilmiah” (scientific impact) criterion."

msgid "plugins.generic.citationImpact.charts"
msgstr "Charts"

msgid "plugins.generic.citationImpact.dist"
msgstr "Citation distribution"

msgid "plugins.generic.citationImpact.dist.note"
msgstr "How many of the {$total} checked articles fall in each citation range."

msgid "plugins.generic.citationImpact.dist.band"
msgstr "{$band} citations"

msgid "plugins.generic.citationImpact.legend.ramp"
msgstr "Darker bars = more recent publication years ({$from} → {$to})"

msgid "plugins.generic.citationImpact.legend.band"
msgstr "Shaded: last 3 years ({$from}–{$to}), {$articles} articles, {$citations} citations"

msgid "plugins.generic.citationImpact.chart.window"
msgstr "LAST 3 YEARS"

msgid "plugins.generic.citationImpact.top.title"
msgstr "Most influential articles"

msgid "plugins.generic.citationImpact.fcrTimes"
msgstr "{$n}× field average"

msgid "plugins.generic.citationImpact.stat.mean"
msgstr "Mean per article"

msgid "plugins.generic.citationImpact.stat.max"
msgstr "Highest (one article)"


msgid "plugins.generic.citationImpact.settings.accentColor"
msgstr "Accent colour"

msgid "plugins.generic.citationImpact.settings.accentColor.theme"
msgstr "Leave empty to follow the active theme's colour ({$colour}). Or enter your own colour, e.g. #1e6292."

msgid "plugins.generic.citationImpact.settings.accentColor.auto"
msgstr "Leave empty to follow the active theme: the colour is taken from the theme's links, header or buttons as shown to visitors. Or enter your own colour, e.g. #1e6292."

msgid "plugins.generic.citationImpact.settings.accentColor.invalid"
msgstr "Enter a hex colour such as #1e6292, or leave the field empty."

msgid "plugins.generic.citationImpact.chart.citation"
msgstr "citation"

msgid "plugins.generic.citationImpact.sourceMerged"
msgstr "Each article counts the higher of the two numbers, because each database misses some citing works."

msgid "plugins.generic.citationImpact.and"
msgstr "and"

msgid "plugins.generic.citationImpact.openAlexDetails"
msgstr "Details on OpenAlex"

msgid "plugins.generic.citationImpact.sourceCount"
msgstr "{$source}: {$n}"

msgid "plugins.generic.citationImpact.settings.sources"
msgstr "Citation sources"

msgid "plugins.generic.citationImpact.settings.sources.description"
msgstr "Indonesian accreditation (ARJUNA) counts Dimensions. With the recommended option every figure uses Dimensions and OpenAlex is shown in its own box and column, never added in."

msgid "plugins.generic.citationImpact.settings.sources.both"
msgstr "Dimensions (main) + OpenAlex for comparison (recommended)"

msgid "plugins.generic.citationImpact.settings.sources.dimensions"
msgstr "Dimensions only"

msgid "plugins.generic.citationImpact.settings.sources.openalex"
msgstr "OpenAlex only"

msgid "plugins.generic.citationImpact.settings.openAlexKey"
msgstr "OpenAlex API key (optional)"

msgid "plugins.generic.citationImpact.settings.openAlexKey.description"
msgstr "Without a key, OpenAlex gives a small free daily budget shared with every site on your server's IP address. A free key at openalex.org/settings/api gives the journal its own budget."

msgid "plugins.generic.citationImpact.settings.openAlexKey.invalid"
msgstr "The OpenAlex API key looks wrong: letters, digits, - and _ only."

msgid "plugins.generic.citationImpact.settings.articleBadge"
msgstr "Show the citation count on article pages (articles with at least one citation)"

msgid "plugins.generic.citationImpact.status.oaWait"
msgstr "OpenAlex daily limit reached; OpenAlex updates resume after {$date}. Add an API key to avoid this."

msgid "plugins.generic.citationImpact.badge.title"
msgstr "Citations"

msgid "plugins.generic.citationImpact.badge.merged"
msgstr "Highest count of Dimensions and OpenAlex."

