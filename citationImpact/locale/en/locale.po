msgstr "Update now"

msgid "plugins.generic.citationImpact.refresh.running"
msgstr "Fetching citations… {$remaining} articles left. Keep this window open."

msgid "plugins.generic.citationImpact.refresh.done"
msgstr "Done. All data is up to date."

msgid "plugins.generic.citationImpact.refresh.busy"
msgstr "Another update is running, waiting…"

msgid "plugins.generic.citationImpact.refresh.backoff"
msgstr "A citation source asked us to slow down (Dimensions: 15 minutes; OpenAlex: until its daily limit resets). Updates resume automatically."

msgid "plugins.generic.citationImpact.refresh.error"
msgstr "The server could not be reached. Retrying in 10 seconds…"

msgid "plugins.generic.citationImpact.refresh.stopped"
msgstr "Stopped after repeated errors from a citation source. Try again later."

msgid "plugins.generic.citationImpact.refresh.help"
msgstr "Only needed for the first fill or after big changes; afterwards the plugin updates itself every hour."

msgid "plugins.generic.citationImpact.status.justNow"
msgstr "Last update: just now"

msgid "plugins.generic.citationImpact.status.error"
msgstr "The plugin could not read the article list. Please send this message to the plugin maintainer:"

