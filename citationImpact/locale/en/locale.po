msgstr "The same articles according to OpenAlex. Shown for comparison only: the figures above use Dimensions, as Indonesian accreditation (ARJUNA) does."

msgid "plugins.generic.citationImpact.oa.window"
msgstr "Citations, articles {$from}–{$to}"

msgid "plugins.generic.citationImpact.oa.colHelp"
