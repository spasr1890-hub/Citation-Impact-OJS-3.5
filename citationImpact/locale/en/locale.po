msgstr "The figures use Dimensions only, as Indonesian accreditation (ARJUNA) does. <a href=\"https://openalex.org/\" target=\"_blank\" rel=\"noopener\">OpenAlex</a> is shown separately for comparison and is not counted."

msgid "plugins.generic.citationImpact.badge.separate"
msgstr "OpenAlex shown for comparison."

