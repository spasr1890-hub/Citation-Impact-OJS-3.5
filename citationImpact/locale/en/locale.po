msgstr "Publication years"

msgid "plugins.generic.citationImpact.filter.allYears"
msgstr "All years"

msgid "plugins.generic.citationImpact.filter.window"
msgstr "Last 3 years ({$from}–{$to})"

msgid "plugins.generic.citationImpact.settings.window"
msgstr "\"Last 3 years\" window"

msgid "plugins.generic.citationImpact.settings.window.current"
msgstr "{$from}–{$to}: current year and the two before"

msgid "plugins.generic.citationImpact.settings.window.full"
msgstr "{$from}–{$to}: the three full years before"

msgid "plugins.generic.citationImpact.settings.window.description"
msgstr "Publication years summed for the \"last 3 years\" citation count (the ARJUNA scientific impact criterion). Match the window your assessor uses."

msgid "plugins.generic.citationImpact.sourceChip"
msgstr "Data: {$sources}"

msgid "plugins.generic.citationImpact.stat.recentLine"
msgstr "{$number} of them in the last 2 years"

msgid "plugins.generic.citationImpact.stat.citedLine"
msgstr "{$cited} of {$total} articles cited"

msgid "plugins.generic.citationImpact.stat.citedNote"
msgstr "Share of checked articles with at least one citation"

