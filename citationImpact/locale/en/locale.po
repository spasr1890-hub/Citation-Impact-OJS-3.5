msgstr "Showing {$shown} of {$total}"

msgid "plugins.generic.citationImpact.source"
msgstr "Citation data: {$sources}. Counts may differ from Google Scholar, Scopus or Crossref because their coverage differs."

msgid "plugins.generic.citationImpact.pending"
msgstr "Some articles have not been checked yet; numbers will grow after the next update."

msgid "plugins.generic.citationImpact.withoutDoi"
msgstr "{$number} published articles without a DOI are not counted."

msgid "plugins.generic.citationImpact.menuItem.title"
msgstr "Citation Impact"

msgid "plugins.generic.citationImpact.menuItem.description"
msgstr "Link to the Citation Impact page (citations from Dimensions and OpenAlex)."

msgid "plugins.generic.citationImpact.settings.description"
msgstr "Citation counts are taken from the free Dimensions Metrics API and OpenAlex for every published article with a DOI. Data is refreshed automatically every hour in small batches. Dimensions data is free for non-commercial use; journal sites should contact publishing@digital-science.com. OpenAlex data is CC0."

msgid "plugins.generic.citationImpact.settings.pagePath"
msgstr "Page path"

msgid "plugins.generic.citationImpact.settings.pagePath.description"
msgstr "The page is shown at /index.php/journal/path. Lowercase letters, numbers, - and _ only."

msgid "plugins.generic.citationImpact.settings.pagePath.invalid"
msgstr "Use lowercase letters, numbers, - and _ only."

msgid "plugins.generic.citationImpact.settings.listMode"
msgstr "Article list"

msgid "plugins.generic.citationImpact.settings.listMode.cited"
msgstr "Only cited articles"

msgid "plugins.generic.citationImpact.settings.listMode.all"
msgstr "All articles"

msgid "plugins.generic.citationImpact.settings.ttlDays"
msgstr "Re-check each article every (days)"

msgid "plugins.generic.citationImpact.settings.ttlDays.description"
msgstr "Between 1 and 90. The default of 7 is gentle on the Dimensions and OpenAlex services."

msgid "plugins.generic.citationImpact.settings.ttlDays.invalid"
msgstr "Enter a whole number between 1 and 90."

msgid "plugins.generic.citationImpact.settings.contactEmail"
msgstr "Contact email"

msgid "plugins.generic.citationImpact.settings.contactEmail.description"
msgstr "Sent to Dimensions and OpenAlex with each request so they can contact the journal."

msgid "plugins.generic.citationImpact.settings.contactEmail.invalid"
msgstr "Enter a valid email address."

msgid "plugins.generic.citationImpact.status.title"
msgstr "Status"

msgid "plugins.generic.citationImpact.status.checkedOf"
msgstr "of {$total} articles with a DOI checked"

msgid "plugins.generic.citationImpact.status.updated"
msgstr "Last update: {$date}"

msgid "plugins.generic.citationImpact.status.never"
msgstr "Not updated yet."

msgid "plugins.generic.citationImpact.status.withoutDoi"
msgstr "{$number} articles without a DOI"

msgid "plugins.generic.citationImpact.status.viewPage"
msgstr "View page"

