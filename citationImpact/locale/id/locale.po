msgid "plugins.generic.citationImpact.settings.description"
msgstr "Jumlah sitasi diambil dari Dimensions Metrics API (gratis) untuk setiap artikel terbit yang memiliki DOI. Data diperbarui otomatis setiap jam dalam kelompok kecil. Data Dimensions gratis untuk penggunaan non-komersial; pengelola situs jurnal diminta menghubungi publishing@digital-science.com."

msgid "plugins.generic.citationImpact.settings.pagePath"
msgstr "Alamat halaman"

